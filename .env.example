# ==============================================================================
# HƯỚNG DẪN CẤU HÌNH .ENV - TIKTOK STREAK FLOW (REP CHUỖI TIKTOK TỰ ĐỘNG)
# ==============================================================================
#
# Cách sử dụng:
# 1. Chạy trên máy tính cá nhân: Sao chép file này thành '.env' ở thư mục gốc dự án.
# 2. Chạy trên GitHub Actions (Khuyên dùng để chạy FREE 24/7 không cần mở máy):
#    Vào Repo GitHub -> Settings -> Secrets and variables -> Actions
#    Thêm các biến bên dưới vào mục "Repository secrets" hoặc "Repository variables".
#
# LƯU Ý QUAN TRỌNG:
# - 'TASKS' và 'COOKIES_<unique_id>' là BẮT BUỘC.
# - Tất cả chuỗi JSON (như TASKS và COOKIES) phải nằm trên 1 DÒNG DUY NHẤT.
# - <unique_id> trong COOKIES_<unique_id> phải trùng khớp chính xác với unique_id trong TASKS.
# ==============================================================================

# [BẮT BUỘC] Danh sách tài khoản TikTok và bạn bè cần rep chuỗi (JSON 1 dòng)
# Giải thích các trường:
# - username: Tên gợi nhớ (để hiển thị trong log, đặt tùy ý).
# - unique_id: ID định danh cho tài khoản này (viết liền không dấu, ví dụ: tiktok_acc1).
# - targets: Danh sách bạn bè cần gửi tin nhắn giữ chuỗi (nhập @username hoặc tên hiển thị của bạn bè).
TASKS=[{"username":"Tài khoản của tôi","unique_id":"my_tiktok_1","targets":["@ban_than_1","ban_than_2"]}]

# [BẮT BUỘC] Cookie đăng nhập tài khoản TikTok (JSON 1 dòng)
# Tên biến: COOKIES_<unique_id> (viết hoa, ví dụ: COOKIES_MY_TIKTOK_1)
# Hướng dẫn lấy cookie:
# 1. Cài tiện ích "Cookie-Editor" trên trình duyệt Chrome/Edge.
# 2. Đăng nhập vào https://www.tiktok.com trên trình duyệt đó.
# 3. Mở tiện ích Cookie-Editor -> bấm nút "Export" -> chọn "Export as JSON".
# 4. Dán toàn bộ chuỗi JSON vào đây (đảm bảo nằm trên 1 dòng).
# Lưu ý: Cookie quan trọng nhất là 'sessionid'.
COOKIES_MY_TIKTOK_1=[{"name":"sessionid","value":"your_session_id_here","domain":".tiktok.com","path":"/"}]

# [TÙY CHỌN] Ngôn ngữ tin nhắn giữ chuỗi
# - vi: Tiếng Việt (Mặc định)
# - en: English (Tiếng Anh)
# - bilingual: Song ngữ Việt - Anh
STREAK_LANGUAGE=vi

# [TÙY CHỌN] Mẫu tin nhắn gửi đi để rep chuỗi
# - Mặc định: [RANDOM_MESSAGE] (tự động chọn ngẫu nhiên các câu chúc/rep chuỗi thân thiện)
# - Các placeholder hỗ trợ:
#   + [RANDOM_MESSAGE]: Chọn ngẫu nhiên câu giữ chuỗi theo ngôn ngữ
#   + [EMOJI]: Icon ngẫu nhiên (🔥, ⚡, ✨, 💖, 🎉, 🚀, 🍀)
#   + [TARGET]: Tên của người bạn / nhóm nhận tin nhắn
#   + [DATE]: Ngày hiện tại (dd/mm/yyyy)
#   + [TIME]: Giờ hiện tại (HH:MM)
# Ví dụ mẫu tùy chỉnh:
# MESSAGE_TEMPLATE=🔥 Duy trì chuỗi TikTok hôm nay nè [TARGET]! Chúc bạn ngày mới tốt lành [EMOJI]
MESSAGE_TEMPLATE=[RANDOM_MESSAGE]

# [TÙY CHỌN] Cấp độ ghi nhật ký log (DEBUG / INFO / WARNING / ERROR)
LOG_LEVEL=DEBUG

# [TÙY CHỌN] Thời gian tối đa chờ trang web TikTok tải (đơn vị: mili-giây, mặc định 120000 = 2 phút)
BROWSER_TIMEOUT=120000

# [TÙY CHỌN] Khung giờ gửi tin nhắn (Giờ Việt Nam, cách nhau bằng dấu phẩy)
# Ví dụ: 08:30,20:30 hoặc 21:00
SCHEDULE_TIMES=08:30,20:30

# [TÙY CHỌN] Độ trễ ngẫu nhiên (chống gửi đúng từng giây cố định làm TikTok nghi ngờ bot)
# Giá trị: số phút tối đa ngẫu nhiên (ví dụ 10 = trễ từ 15s đến 10 phút ngẫu nhiên)
RANDOM_DELAY_MINUTES=10

# [TÙY CHỌN] Số lần thử lại nếu gặp sự cố mạng (mặc định: 3)
TASK_RETRY_TIMES=3

# ==============================================================================
# VÍ DỤ CẤU HÌNH NHIỀU TÀI KHOẢN TIKTOK (MULTI-ACCOUNT):
# ==============================================================================
# TASKS=[{"username":"Nick 1","unique_id":"acc1","targets":["@friendA"]},{"username":"Nick 2","unique_id":"acc2","targets":["@friendB","@friendC"]}]
# COOKIES_ACC1=[{"name":"sessionid","value":"xxx","domain":".tiktok.com","path":"/"}]
# COOKIES_ACC2=[{"name":"sessionid","value":"yyy","domain":".tiktok.com","path":"/"}]
